{
  "name": "lens-convex-auth",
  "version": "0.2.1",
  "description": "Drop-in sign-in for Lens apps: thirdweb wallet, Lens account sign-in and creation, and Convex auth.",
  "license": "MIT",
  "author": "Jean Ayala <hola@jeanayala.xyz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsalitre/lens-convex-auth.git"
  },
  "homepage": "https://github.com/mrsalitre/lens-convex-auth#readme",
  "bugs": "https://github.com/mrsalitre/lens-convex-auth/issues",
  "keywords": [
    "lens",
    "lens-protocol",
    "thirdweb",
    "convex",
    "auth",
    "web3",
    "react",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./convex": {
      "types": "./dist/convex/index.d.ts",
      "import": "./dist/convex/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lens-convex-auth": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "@lens-chain/storage-client": "^1.0.6",
    "@lens-protocol/client": "*",
    "@lens-protocol/metadata": "^2.1.0",
    "@lens-protocol/react": "*",
    "convex": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "thirdweb": "^5.100.0",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "@lens-chain/storage-client": "^1.0.6",
    "@lens-protocol/client": "0.0.0-canary-20250820102520",
    "@lens-protocol/metadata": "^2.1.0",
    "@lens-protocol/react": "0.0.0-canary-20250820102520",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex": "^1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "thirdweb": "^5.121.6",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.56.8",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0"
}
